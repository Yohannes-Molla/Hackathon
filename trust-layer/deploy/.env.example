# -----------------------------
# Core Infrastructure
# -----------------------------
TL_DB_NAME=trust_layer
TL_DB_USER=tl_user
TL_DB_PASSWORD=tl_password
TL_DB_URL=jdbc:postgresql://postgres:5432/trust_layer

TL_REDIS_HOST=redis
TL_REDIS_PORT=6379

# -----------------------------
# Keycloak / OIDC
# -----------------------------
TL_KEYCLOAK_REALM=trust-layer
TL_KEYCLOAK_BASE_URL=http://host.docker.internal:8180
TL_OIDC_ISSUER_URI=http://host.docker.internal:8180/realms/trust-layer

TL_KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
TL_KEYCLOAK_ADMIN_CLIENT_SECRET=
TL_KEYCLOAK_ADMIN_USERNAME=admin
TL_KEYCLOAK_ADMIN_PASSWORD=admin
TL_KEYCLOAK_ADMIN_REALM=master

# -----------------------------
# Gateway Routing / CORS
# -----------------------------
TL_WEB_ORIGIN=http://localhost:3000
TL_WEB_ORIGIN_ALT=http://127.0.0.1:3000
TL_KEYCLOAK_ORIGIN=http://localhost:8180

TL_AUTH_SERVER_URI=http://auth-server:9000
TL_EKYC_SERVICE_URI=http://ekyc-service:9002
TL_TX_SERVICE_URI=http://tx-service:9003
TL_VCI_SERVICE_URI=http://vci-service:9004

# -----------------------------
# Published Host Ports
# -----------------------------
TL_FRONTEND_PORT=3000
TL_GATEWAY_PORT=8080
TL_AUTH_SERVER_PORT=9000
TL_EKYC_SERVICE_PORT=9002
TL_TX_SERVICE_PORT=9003
TL_VCI_SERVICE_PORT=9004
TL_KEYCLOAK_PORT=8180
TL_POSTGRES_PORT=5433
TL_VAULT_PORT=8200
TL_MAILPIT_UI_PORT=8025
TL_MAILPIT_SMTP_PORT=1025
